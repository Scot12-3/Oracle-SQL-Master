--4 . Find Consecutive Rows
select *     
from   running_log match_recognize (    
  order by run_date    
  measures     
    first ( run_date ) as start_date,    
    count (*) as days    
  pattern ( init consecutive* )    
  define consecutive as run_date = ( prev ( run_date ) + 1 )    
);

  
--5 . Find Three Consecutive Rows
select *     
from   running_log match_recognize (   
  order by run_date    
  measures     
    first ( run_date ) as start_date,    
    count (*) as days   
  all rows per match  
  pattern ( init consecutive{2} )    
  define consecutive as run_date = ( prev ( run_date ) + 1 )    
);
